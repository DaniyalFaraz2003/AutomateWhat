# AutomateWhat - .gitignore

# ============================================
# Python
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ============================================
# Virtual Environments
# ============================================

# Virtual environments
venv/
ENV/
env/
.venv

# ============================================
# Project Specific - Logs & Screenshots
# ============================================

# Log files
logs/
*.log

# Screenshots
screenshots/
*.png
*.jpg
*.jpeg

# ============================================
# AI Models & Large Files
# ============================================

# HuggingFace models (these are large)
models/hf_models/
**/models--*/
**/hub/

# YOLO models (these are large)
models/yolo_models/*.pt
models/yolo_models/*.weights

# Tesseract OCR (executable files)
models/Tesseract-OCR/
**/*.exe
**/*.dll

# Model cache files
*.cache
**/.model-cache/
**/model-cache/
/models

# ============================================
# Dataset & Training Files
# ============================================

# Dataset directories (keep yaml files but not images)
dataset/images/
dataset/labels/
dataset/.cache/
*.cache

# Training outputs
runs/
wandb/
mlruns/
tensorboard/

# ============================================
# IDE & Editors
# ============================================

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# ============================================
# OS Specific
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# Temporary & Backup Files
# ============================================

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.old

# System files
.directory
.project
.settings
*.sublime-*

# ============================================
# Environment & Secrets
# ============================================

# Environment variables
.env
.env.local
.env.*.local

# API keys and secrets
*.key
*.pem
config/secrets.py
secrets/

# ============================================
# Build & Deployment
# ============================================

# Compiled files
*.pyc
*.pyo
*.pyd

# Compiled extensions
*.exe
*.dll
*.dylib
*.so

# ============================================
# Keep Important Files
# ============================================

# Keep README and documentation
!README.md
!**/*.md
!.gitignore

# Keep requirements
!requirements.txt

# Keep configuration template files
!config/
!**/settings.py
!**/theme.py

# Keep source code
!**/*.py

# Keep test files
!tests/
!**/*test*.py

# Keep assets
!assets/
!**/*.json

# Keep documentation
!docs/

